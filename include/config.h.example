#pragma once

#include "battery_type.hpp"
#include "balance_mode.hpp"

#include <string_view>

// Battery configuration
#define BATTERY_MODULE_LG_WH 6850
#define BATTERY_MODULE_CATL_WH 7060

#define LED_ON HIGH
#define LED_OFF LOW

struct Config {
/**
 * meb8s:   8s batteries
 * meb12s:  12s batteries
 * mebAuto: detect 8s or 12s on every measure
 */
constexpr BatteryConfig battery_config = BatteryConfig::mebAuto;
/**
 * slave:   balance if mqtt request from master
 * single:  balance solo
 * none:    dont balance
 */
constexpr BalanceMode bms_mode = BalanceMode::single;

// Battery configuration
#define BATTERY_MODULE_LG_WH 6850
#define BATTERY_MODULE_CATL_WH 7060

