static constexpr uint8_t can_tx_pin = 23;
static constexpr uint8_t can_rx_pin = 22;
#endif

constexpr float max_cell_voltage = 4.1f;
constexpr float min_cell_voltage = 3.4f;
constexpr float default_cell_voltage = 3.7f;

constexpr float max_current = 25.f;

constexpr unsigned int battery_cells_per_module = 12;
constexpr unsigned int battery_modules = 12;
constexpr unsigned long battery_wh_max = BATTERY_MODULE_CATL_WH * battery_modules;

